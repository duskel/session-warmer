{
  "timezone": "Asia/Karachi",
  "state_path": "/var/lib/session-warmer/state.json",
  "notify": {
    "enabled": true,
    "resend_api_key_env": "RESEND_API_KEY",
    "from": "Session Warmer <warmer@duskel.com>",
    "to": ["you@example.com"],
    "min_interval_minutes": 60
  },
  "providers": {
    "claude": {
      "enabled": true,
      "command": ["claude", "-p", "Reply with the single word: ready"],
      "cwd": "/var/lib/session-warmer",
      "timeout_seconds": 120,
      "limit_patterns": [
        "usage limit reached",
        "rate limit",
        "you'?ve reached your",
        "out of (?:messages|requests|credits)",
        "too many requests",
        "quota exceeded"
      ],
      "weekly_patterns": ["weekly limit", "weekly usage limit", "reached your weekly"],
      "reset_patterns": ["reset[s]? (?:at|in) ([^\\n.]+)", "try again (?:at|in) ([^\\n.]+)"]
    },
    "codex": {
      "enabled": true,
      "command": ["codex", "exec", "--skip-git-repo-check", "Reply with the single word: ready"],
      "cwd": "/var/lib/session-warmer",
      "timeout_seconds": 120,
      "limit_patterns": [
        "usage limit reached",
        "rate limit",
        "you'?ve reached your",
        "out of (?:messages|requests|credits)",
        "too many requests",
        "quota exceeded"
      ],
      "weekly_patterns": ["weekly limit", "weekly usage limit", "reached your weekly"],
      "reset_patterns": ["reset[s]? (?:at|in) ([^\\n.]+)", "try again (?:at|in) ([^\\n.]+)"]
    }
  }
}
